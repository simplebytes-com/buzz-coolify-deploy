# Public routing
BUZZ_DOMAIN=buzz.example.com
BUZZ_PUBLIC_URL=https://buzz.example.com
BUZZ_RELAY_URL=wss://buzz.example.com

# Immutable Buzz relay image produced by the latest successful upstream build.
BUZZ_IMAGE_TAG=sha-63496cc

# The owner's 64-character hex Nostr public key. Do not use an npub value here.
RELAY_OWNER_PUBKEY=CHANGE_ME_OWNER_PUBKEY_HEX

# Generate these once and keep them stable across redeployments.
BUZZ_RELAY_PRIVATE_KEY=CHANGE_ME_64_HEX_PRIVATE_KEY
BUZZ_GIT_HOOK_HMAC_SECRET=CHANGE_ME_RANDOM_64_HEX
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_PASSWORD
REDIS_PASSWORD=CHANGE_ME_RANDOM_PASSWORD
BUZZ_S3_ACCESS_KEY=CHANGE_ME_RANDOM_ACCESS_KEY
BUZZ_S3_SECRET_KEY=CHANGE_ME_RANDOM_SECRET_KEY

# Stable non-secret defaults
POSTGRES_DB=buzz
POSTGRES_USER=buzz
BUZZ_S3_BUCKET=buzz-media
BUZZ_REQUIRE_RELAY_MEMBERSHIP=true
BUZZ_SERVE_GIT_WEB_GUI=false

